# ============================================================
#  Variables de entorno del backend bckndpucp
#  Copia este archivo como ".env" y ajusta los valores.
#  NUNCA subas ".env" a git (ya está en .gitignore).
# ============================================================

# --- Servidor ---
PORT=3000
# Prefijo de URL para todos los endpoints. "" en local.
# En producción con subcarpeta usar, p.ej.: /backendpucp/
BASE_PATH=

# --- Base de datos (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pucp
DB_USER=root
DB_PASSWORD=
# Modo de sincronización de Sequelize al arrancar:
#   none  -> no sincronizar (recomendado en producción)
#   alter -> ALTER TABLE (peligroso en producción)
#   force -> recrear tablas (¡borra datos! solo desarrollo)
DB_SYNC=none
# true = mostrar SQL en consola (por defecto), false = silenciar
DB_LOGGING=true

# --- Autenticación ---
# Secreto con el que se firman los tokens del login y se validan en cada
# petición. Si se deja vacío se usa 'secretkey', que está en el código: con eso
# cualquiera podría fabricarse un token válido. Usa una cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Al cambiarlo se invalidan los tokens ya emitidos (todos vuelven a entrar).
JWT_SECRET=

# --- CORS ---
# Lista separada por comas de orígenes permitidos. "*" = todos.
CORS_ORIGIN=*

# --- Documentos del histórico de categoría ---
# Carpeta donde se guardan los PDF/Word/imágenes que sustentan los eventos de
# categoría. El archivo se sube por trozos de 64 KB y se guarda aquí, no en la
# base de datos (así el JSON de `categoria` queda pequeño y la tabla lista rápido).
# Por defecto: una carpeta hermana de la aplicación.
# IMPORTANTE: que quede FUERA de public_html (son documentos de docentes).
# Ejemplo: DIR_DOCUMENTOS=/home/USUARIO/documentos-docentes
DIR_DOCUMENTOS=
